# OVH Managed PostgreSQL
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/kemirix_knowledge?sslmode=require

# OVH Object Storage (S3-compatible)
OVH_S3_ENDPOINT=
OVH_S3_REGION=
OVH_S3_ACCESS_KEY=
OVH_S3_SECRET_KEY=
OVH_S3_BUCKET=kemirix-knowledge-raw

# API keys where required
OPENFDA_API_KEY=

# Runtime
KEMIRIX_ENV=development
LOG_LEVEL=INFO
